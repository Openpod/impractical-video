# Copy with `npm run setup`. The default is a private, single-user local app.
# Keep both mode flags equal; NEXT_PUBLIC_* values are embedded at build time.
APP_MODE=local
NEXT_PUBLIC_APP_MODE=local
NEXT_PUBLIC_DESKTOP_CLOUD_ENABLED=false
NEXT_PUBLIC_APP_URL=http://localhost:3000
VIDEO_FS_APP_URL=http://localhost:3000

# Optional alternative to Account → API keys in the app. A saved key takes priority.
# Your own fal.ai key for image, video, and audio generation.
# Provider usage is billed by fal.ai. Editing your own media needs no API key.
FAL_KEY=

# Optional: absolute path to claude or codex. Otherwise detected on PATH.
VIDEO_FS_COMPOSER_CLI=

# Optional: project storage directory; defaults to ./data/projects.
VIDEO_FS_DATA_ROOT=

# Optional: private settings directory, outside projects. Defaults to the
# settings/ sibling of the project data root (packaged desktop uses userData).
VIDEO_FS_SETTINGS_ROOT=

# Created automatically by `npm run setup`. Never put it in project files.
PAPER_MCP_TOKEN=
VIDEO_FS_REQUIRE_PROJECT_BINDING=true
