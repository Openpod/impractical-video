# Optional hosted deployment only. For local use, run npm run setup with .env.example.
APP_MODE=hosted
NEXT_PUBLIC_APP_MODE=hosted
NEXT_PUBLIC_DESKTOP_CLOUD_ENABLED=false

OPENROUTER_API_KEY=
VIDEO_FS_AGENT_MODEL=openai/gpt-5.3-codex

# Optional. The app defaults to these image/video endpoints when FAL_KEY exists.
FAL_KEY=
FAL_IMAGE_ENDPOINT=openai/gpt-image-2
FAL_TEXT_TO_VIDEO_ENDPOINT=bytedance/seedance-2.0/fast/text-to-video
FAL_IMAGE_TO_VIDEO_ENDPOINT=bytedance/seedance-2.0/fast/image-to-video

# Optional audio endpoint. Leave unset unless you know the Fal audio model input shape.
FAL_AUDIO_ENDPOINT=

# --- Auth (Clerk) ----------------------------------------------------------
# Required for sign-in/sign-up and persistence. Public key is exposed to the
# browser; secret key is server-only. Sign-in/up URLs point at the catch-all
# routes added under app/sign-in and app/sign-up.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# --- Database / storage (Supabase) -----------------------------------------
# Server access uses the service-role key (bypasses RLS; auth is enforced at
# the Clerk route boundary). Anon key is for browser realtime only.
# Schema: database/video_fs_initial_schema.sql
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Durable chat runs (Trigger.dev) ---------------------------------------
# The chat agent loop runs as a Trigger.dev task so it survives the request
# and supports resume/abort. Project ref + secret from the Trigger dashboard.
TRIGGER_PROJECT_REF=
TRIGGER_SECRET_KEY=

# Public base URL, used for building absolute redirect/callback URLs.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Internal auth: shared secret so the Trigger runner can act as a user on the
# chat callback. MUST be set in production (blocks the triggerUserId bypass).
INTERNAL_API_SECRET=

# Stripe (one-time credit checkout + legacy subscriptions via webhook)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_STANDARD_PRICE_ID=
STRIPE_PRO_PRICE_ID=
STRIPE_STANDARD_ANNUAL_PRICE_ID=
STRIPE_PRO_ANNUAL_PRICE_ID=
