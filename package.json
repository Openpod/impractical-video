{
  "name": "video-fs-agent",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack --hostname localhost",
    "build": "next build",
    "start": "next start --hostname localhost",
    "desktop:bundle-mcp": "node desktop/build-mcp.mjs",
    "desktop:build-web": "node desktop/build-web.mjs",
    "desktop:stage": "node desktop/stage-standalone.mjs",
    "desktop:dev": "electron desktop/main.mjs",
    "desktop:mcp": "electron desktop/main.mjs --mcp",
    "desktop:security-test": "node --test desktop/security.test.mjs desktop/auth-session-store.test.mjs",
    "desktop:setup-test": "node --test desktop/agent-setup.test.mjs",
    "desktop:setup": "node desktop/setup-agent.mjs --project-id",
    "desktop:release:check": "node scripts/check-desktop-release.mjs",
    "desktop:dist:mac": "npm run desktop:release:check && npm run desktop:build-web && npm run desktop:bundle-mcp && npm run desktop:stage && electron-builder --projectDir desktop --mac",
    "desktop:dist:mac:unsigned": "npm run desktop:build-web && npm run desktop:bundle-mcp && npm run desktop:stage && CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --projectDir desktop --mac",
    "paper:mcp": "node scripts/local-agent.mjs --mcp",
    "paper:setup": "node scripts/local-agent.mjs --setup --project-id",
    "lint": "eslint .",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "release:env": "node scripts/check-release-env.mjs",
    "extract:video-portfolio": "tsx scripts/extract-video-portfolio.ts",
    "backfill:published-display": "tsx scripts/backfill-published-display-images.ts",
    "publish:curated-portfolios": "tsx scripts/publish-curated-portfolios.ts",
    "trigger:dev": "set -a; . ./.env.local; set +a; npx trigger.dev@latest dev",
    "trigger:deploy": "npx trigger.dev@latest deploy",
    "setup": "node scripts/setup-local.mjs",
    "doctor": "node scripts/doctor.mjs",
    "test:desktop": "node --test desktop/*.test.mjs",
    "test:smoke": "playwright test",
    "check": "npm run lint && npm run typecheck && npm test && npm run test:desktop",
    "release:source": "node scripts/export-source.mjs",
    "release:scan": "node scripts/check-source.mjs"
  },
  "dependencies": {
